{
  "description": "Shorts style: 1-3 big uppercase words, the spoken word turns yellow and pops.",
  "font": "Montserrat Black",
  "size": 0.1,
  "uppercase": true,
  "strip_punct": true,
  "color": "#FFFFFF",
  "highlight": "#FFE14D",
  "highlight_scale": 1.08,
  "outline_color": "#000000",
  "outline": 0.09,
  "shadow": 0.04,
  "shadow_color": "#000000B0",
  "box": false,
  "position": "bottom",
  "margin_v": 0.24,
  "pop_in": true,
  "chunk": {"max_words": 3, "max_chars": 22, "max_duration": 2.0, "max_gap": 0.45, "soft_break_min_words": 2, "min_duration": 0.4, "max_line_chars": 16}
}
